MODEL_ID=OvozifyLabs/whisper-small-uz-v1
MODEL_PATH=./models/whisper-small-uz-v1
HF_HOME=./models/cache
MODEL_REVISION=main

# auto selects CUDA, Apple Metal, or CPU. Railway should use cpu.
DEVICE=auto
PRELOAD_MODEL=true
MAX_NEW_TOKENS=256
TORCH_NUM_THREADS=4
CPU_QUANTIZE=true
TORCH_QUANTIZED_ENGINE=fbgemm
LOG_LEVEL=INFO

# Leave empty for a private deployment with no auth requirement.
STT_API_KEY=
CORS_ORIGINS=*
MAX_AUDIO_MB=50
MAX_AUDIO_SECONDS=300
PORT=8090

# Navoiy TTS (Uzbek text-to-speech). Off by default: it needs a CUDA GPU and the
# assets from setup_tts_model.py. See README's Text-to-speech section — deploy with
# Dockerfile.voice / railway.voice.toml to run STT and TTS together on one origin
# (Dockerfile.voice already sets TTS_ENABLED=true), or leave this off and keep using
# the CPU-only Dockerfile above for STT alone.
TTS_ENABLED=false
TTS_MODEL_ID=aisha-org/navoiy-tts
TTS_MODEL_PATH=./models/navoiy-tts
TTS_COSYVOICE_DIR=./models/CosyVoice
TTS_COSYVOICE_REPO=https://github.com/FunAudioLLM/CosyVoice.git
TTS_BASE_MODEL_ID=FunAudioLLM/CosyVoice2-0.5B
TTS_BASE_MODEL_DIR=./models/CosyVoice/pretrained_models/CosyVoice2-0.5B
TTS_CHECKPOINT_PATH=./models/navoiy-tts/emotion_600h_joint.pt
TTS_REFERENCE_PATH=./models/navoiy-tts/reference.wav
TTS_DEFAULT_EMOTION=calm
TTS_MAX_TEXT_CHARS=500
TTS_INFERENCE_TIMEOUT_SECONDS=180

# --- /voicelab pipeline bench: live STT, OpenAI agent, VoiceLab TTS ---
# A hosted alternative to the Navoiy TTS above; the two are independent.
VOICELAB_API_KEY=vlk_TML4n-vva9Dhki7X3zQOnRSQCOwic8u8Eyy-z7APWeg
VOICELAB_BASE_URL=https://api.voicelab.uz
VOICELAB_TIMEOUT_SECONDS=90
VOICELAB_STT_POLL_SECONDS=0.7
VOICELAB_STT_POLL_TIMEOUT_SECONDS=90

# The reservation agent. Put the real key in .env, which is gitignored; the
# page can also override it per session.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=45
